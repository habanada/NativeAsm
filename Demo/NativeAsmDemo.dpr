begin
  Writeln('NativeAsm — Demo / Self-Test');
  Writeln('=====================================');

  Passed := 0;
  Failed := 0;

  try
    Demo_ReturnConstant;
    Demo_AddArgs;
    Demo_LoopSum;
    Demo_MaxOfTwo;
    Demo_IntLabel;
    Demo_AlignTo;
    Demo_RegisterCasts;
    Demo_SyscallStub;
    Demo_IatThunk;
    Demo_JitAllocator;
    Demo_ConstPool;
    Demo_HexDump;
    Demo_8BitArithmetic;
    Demo_MovImmWidth;
    Demo_ShiftWidth;
    Demo_Imul32;
    Demo_NegativeCases;

    Writeln;
    Writeln('=====================================');
    Writeln(Format('Results: %d passed, %d failed', [Passed, Failed]));

    if Failed > 0 then
      ExitCode := 1;

  except
    on E: Exception do
    begin
      Writeln('FATAL: ', E.ClassName, ': ', E.Message);
      ExitCode := 2;
    end;
  end;

  if DebugHook <> 0 then
  begin
    Writeln; Write('Press Enter to exit...'); Readln;
  end;
end.
